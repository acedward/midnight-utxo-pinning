From 99e75c003f4616253de1b37d0ad72d34df875eb1 Mon Sep 17 00:00:00 2001
From: Eddie <edward.alvarado@midnight.foundation>
Date: Tue, 8 Sep 2026 19:18:31 -0300
Subject: [PATCH 4/8] docs(spec): readable layout for the coin lifecycle
 diagram

---
 docs/spec/coin-lifecycle.puml | 42 +++++++++++++++++------------------
 docs/spec/coin-lifecycle.svg  |  2 +-
 2 files changed, 22 insertions(+), 22 deletions(-)

diff --git a/docs/spec/coin-lifecycle.puml b/docs/spec/coin-lifecycle.puml
index 532d923..1ecc8d1 100644
--- a/docs/spec/coin-lifecycle.puml
+++ b/docs/spec/coin-lifecycle.puml
@@ -1,36 +1,36 @@
 @startuml
+left to right direction
+skinparam nodesep 40
+skinparam ranksep 50
 
-state pending as "Pending": Coin expected to be received\nPart of pending balance\n(not counted if expected from a scope-submitted transaction)
+state pending as "Pending": Coin expected to be received\nPart of pending balance (not counted if expected\nfrom a scope-submitted transaction)
 state confirmed as "Confirmed": Coin received in a transaction added to the chain\nPart of pending balance
 state final as "Final": Coin received in a finalized transaction\nPart of available balance\nMay carry 'outstanding' entries: transactions that\ncould still consume it (warning shown, still available)
-state booked as "Booked" {
-  state bookedTx as "by transaction": Coin booked for a pending transaction\n(current behaviour)
-  state bookedHold as "by hold": Pinned: reserved by a hold, idle\nPart of the owning scope's held balance
-  state bookedBoth as "by hold and transaction": Pinned and booked by a candidate being built
-  bookedHold --> bookedBoth : spend(authorization)
-  bookedBoth --> bookedHold : detach_transaction | discard
+state booked as "Booked (not part of balance)" {
+  state bookedTx as "by transaction": Booked for a pending transaction\n(current behaviour)
+  state bookedHold as "by hold": Pinned: reserved by a hold, idle\nIn the owning scope's held balance
+  state bookedBoth as "by hold and transaction": Pinned and booked by a\ncandidate being built
+  bookedHold -down-> bookedBoth : spend(authorization)
+  bookedBoth -up-> bookedHold : detach_transaction\n| discard
 }
-note right of booked : Not part of available balance
-state spent as "Spent" : Coin that was spent in a transaction\nNot part of balance
+note bottom of booked : rollback of a transaction that spent\nbooked coins keeps them booked
+state spent as "Spent" : Coin spent in a transaction\nNot part of balance
 
 [*] --> confirmed : apply(receive)
-[*] --> pending : spend
-[*] --> pending : watch_for
+[*] --> pending : spend | watch_for
 pending --> confirmed : apply(receive)
 confirmed --> final : finalize
 confirmed --> pending : rollback
 confirmed --> [*] : discard
-final --> bookedTx : spend|apply(spend)
-final --> bookedHold : hold
-bookedHold --> final : release_hold | expiry\n(adds 'outstanding' entries)
-bookedTx --> final : discard\n(adds 'outstanding' entry if shared)
-
-booked --> spent : apply
-booked --> booked : rollback
-final --> spent : apply (outstanding transaction settled)
-spent --> booked : rollback (restores booking record)
-spent --> final : rollback (outstanding)
 pending --> [*] : discard
+final -down-> bookedTx : spend | apply(spend)
+final -down-> bookedHold : hold
+bookedHold -up-> final : release_hold | expiry\n(+ outstanding entries)
+bookedTx -up-> final : discard\n(+ outstanding entry if shared)
+booked -right-> spent : apply
+final -down-> spent : apply\n(outstanding tx settled)
+spent --> booked : rollback\n(restores record)
+spent --> final : rollback\n(outstanding)
 spent --> spent : finalize
 
 @enduml
