diff --git a/docs/spec/tx-lifecycle.puml b/docs/spec/tx-lifecycle.puml
index e2d95b6..fe4c624 100644
--- a/docs/spec/tx-lifecycle.puml
+++ b/docs/spec/tx-lifecycle.puml
@@ -10,6 +10,7 @@ state confirmed as "Confirmed" {
   state failure as "Failure"
 }
 state pending as "Pending"
+state detached as "Detached": Candidate handed off to a scope\nNever submitted by the wallet
 
 state final as "Final" {
   state successF as "Success"
@@ -18,12 +19,17 @@ state final as "Final" {
 }
 
 state rejected as "Rejected"
+state ended as "Invalidated | Stale | Released"
 
 [*] --> pending : spend | watch_for
 [*] --> confirmed : apply
 pending --> confirmed : apply
+pending --> detached : detach_transaction
+detached --> confirmed : apply
+detached --> ended : sibling settles | validity bound passes | release_hold
 confirmed --> final : finalize
 confirmed --> pending : rollback
+confirmed --> detached : rollback (settled candidate)
 pending ---> rejected : discard
 confirmed --> rejected : discard
 
