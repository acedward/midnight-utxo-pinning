+++ b/docs/spec/tx-lifecycle.puml
@@ -17,14 +17,14 @@ state final as "Final" {
   state failureF as "Failure"
 }
 
-state rejected as "Rejected": reason = discarded | released | invalidated | stale | expired\nkeeps validity bound while it may still settle
+state rejected as "Rejected": reason = discarded | detached | invalidated | stale | expired\nkeeps validity bound while it may still settle
 
